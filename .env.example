# Report and repository paths (server defaults already point to /opt)
REPORT_DIR=/opt/Strategy/港A美/机构日报
STRATEGY_DIR=/opt/Strategy
PORT=3003
HOST=127.0.0.1
NODE_ENV=production
# A single persistent API process checks GitHub every hour, including once at startup.
REPORT_AUTO_UPDATE=true
# Optional trusted local reverse proxy. It MUST overwrite X-Forwarded-For.
TRUST_PROXY_LOOPBACK=false
# Empty means same-origin browser access only; this is not authentication.
ALLOWED_ORIGINS=
# Server-only administrator secret. Empty disables management writes.
ADMIN_TOKEN=

# Optional report-only disk cache. Keep it outside dist/public and outside Git.
# Default: data/runtime/report-cache (relative to the service working directory).
REPORT_INDEX_CACHE_DIR=
# Development/on-demand source checks; production auto-updates use the hourly job.
REPORT_INDEX_CHECK_MS=30000

# Optional global AI assistant configuration
# Generate the encryption secret and choose an administrator password independently. Keep both outside Git.
AI_CONFIG_SECRET=
AI_CONFIG_ADMIN_TOKEN=

# Environment-based provider configuration overrides encrypted runtime storage.
AI_PROVIDER_ID=openai
AI_PROVIDER_NAME=OpenAI compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# Operational limits stay on the server. AI allowance is reserved conservatively
# before upstream requests and persisted across restarts, resetting daily in Asia/Shanghai.
AI_TIMEOUT_MS=45000
AI_DAILY_TOKEN_BUDGET=500000
AI_MAX_CONCURRENCY=2

# Release metadata
APP_GIT_COMMIT=
APP_BUILD_TIME=
