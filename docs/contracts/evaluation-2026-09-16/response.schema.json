{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sampleId": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "rawCode": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rating": {
                  "enum": [
                    "买入",
                    "增持",
                    "中性",
                    "持有",
                    "减持",
                    "卖出",
                    "其他",
                    null
                  ]
                },
                "targetPrice": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "institution": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "name",
                "rawCode",
                "rating",
                "targetPrice",
                "institution",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidateId": {
                  "type": "string"
                },
                "op": {
                  "enum": [
                    "keep",
                    "modify",
                    "delete"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "candidateId",
                "op",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "risk",
                    "catalyst"
                  ]
                },
                "subject": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "subject",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "sampleId",
          "records",
          "decisions",
          "issues",
          "signals",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "results"
  ],
  "additionalProperties": false
}
